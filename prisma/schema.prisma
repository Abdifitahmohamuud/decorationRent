generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(uuid())
  fullName             String
  email                String                @unique
  phone                String?               @unique
  password             String
  role                 Role                  @default(CUSTOMER)
  isActive             Boolean               @default(true)
  failedAttempts       Int                   @default(0)
  lastLogin            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  auditLogs            AuditLog[]
  bookings             Booking[]
  cancellationRequests CancellationRequest[]
  notifications        Notification[]
  returnedItems        ReturnedItem[]
  sessions             Session[]
  takenItems           TakenItem[]
}

model Decoration {
  id             String         @id @default(uuid())
  name           String
  description    String
  price          Float
  priceUnitHours Float          @default(1)
  totalQty       Int
  availableQty   Int
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  image          String?
  category       String         @default("General")
  bookingItems   BookingItem[]
  returnedItems  ReturnedItem[]
  takenItems     TakenItem[]
}

model Booking {
  id            String         @id @default(uuid())
  userId        String
  eventDate     DateTime
  endDate       DateTime
  location      String
  status        BookingStatus  @default(REQUEST)
  totalPrice    Float
  deposit       Float
  balance       Float
  isLocked      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  phoneNumber   String?
  user          User           @relation(fields: [userId], references: [id])
  bookingItems  BookingItem[]
  payments      Payment[]
  refunds       Refund[]
  returnedItems ReturnedItem[]
  takenItems    TakenItem[]
}

model BookingItem {
  id           String     @id @default(uuid())
  bookingId    String
  decorationId String
  quantity     Int
  price        Float
  booking      Booking    @relation(fields: [bookingId], references: [id])
  decoration   Decoration @relation(fields: [decorationId], references: [id])
}

model Payment {
  id                    String        @id @default(uuid())
  bookingId             String
  amount                Float
  method                PaymentMethod
  transactionId         String        @unique
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now())
  phoneNumber           String?
  lastRefundAttempt     DateTime?
  rawPaymentResponse    Json?
  rawWaafiResponse      Json?
  referenceId           String?
  refundCount           Int           @default(0)
  refundDate            DateTime?
  refundReason          String?
  refundReferenceId     String?
  refundResponseCode    String?
  refundResponseMessage String?
  refundTransactionId   String?
  responseCode          String?
  responseMessage       String?
  booking               Booking       @relation(fields: [bookingId], references: [id])
  refunds               Refund?
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  sentEmail Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, code])
}

model ReturnedItem {
  id           String             @id @default(uuid())
  bookingId    String
  decorationId String
  userId       String
  quantity     Int
  status       ReturnedItemStatus @default(OK)
  remarks      String?
  returnedAt   DateTime           @default(now())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  booking      Booking            @relation(fields: [bookingId], references: [id])
  decoration   Decoration         @relation(fields: [decorationId], references: [id])
  user         User               @relation(fields: [userId], references: [id])
}

model CancellationRequest {
  id                String             @id @default(uuid())
  originalBookingId String             @unique
  userId            String
  userName          String
  bookingData       Json
  status            CancellationStatus @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id])
}

model TakenItem {
  id           String     @id @default(uuid())
  bookingId    String
  decorationId String
  userId       String
  quantity     Int
  remarks      String?
  takenAt      DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  booking      Booking    @relation(fields: [bookingId], references: [id])
  decoration   Decoration @relation(fields: [decorationId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
}

model Refund {
  id                    String       @id @default(uuid())
  paymentId             String       @unique
  bookingId             String
  originalTransactionId String
  refundTransactionId   String?
  referenceId           String?
  amount                Float
  originalAmount        Float?
  reason                String
  status                RefundStatus
  responseCode          String
  responseMessage       String
  state                 String?
  requestedBy           String
  requestedAt           DateTime     @default(now())
  completedAt           DateTime?
  customerName          String?
  customerPhone         String?
  rawRequest            Json?
  rawResponse           Json
  booking               Booking      @relation(fields: [bookingId], references: [id])
  payment               Payment      @relation(fields: [paymentId], references: [id])
}

enum Role {
  ADMIN
  CUSTOMER
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REQUEST
  TAKEN
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  LOCAL_EVC
  LOCAL_EDAHAB
  LOCAL_SAHAL
  LOCAL_PREMIER_WALLET
  GLOBAL_MASTERCARD
  GLOBAL_PAYPAL
  MOBILE_MONEY
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum NotificationType {
  BOOKING
  PAYMENT
  REMINDER
}

enum ReturnedItemStatus {
  OK
  DAMAGED
}

enum CancellationStatus {
  PENDING
  SUCCESS_CANCELED
  REFUND_FAILED
  REJECTED
}

enum RefundStatus {
  SUCCESS
  FAILED
}
