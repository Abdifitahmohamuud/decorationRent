generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  //url = env("DATABASE_URL")
}

model User {
  id             String         @id @default(uuid())
  fullName       String
  email          String         @unique
  phone          String?        @unique
  password       String
  role           Role           @default(CUSTOMER)
  isActive       Boolean        @default(true)
  failedAttempts Int            @default(0)
  lastLogin      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  auditLogs            AuditLog[]
  bookings             Booking[]
  notifications        Notification[]
  sessions             Session[]
  returnedItems        ReturnedItem[]
  cancellationRequests CancellationRequest[]
  takenItems           TakenItem[]
}

model Decoration {
  id             String        @id @default(uuid())
  name           String
  description    String
  price          Float
  priceUnitHours Float         @default(1)
  totalQty       Int
  availableQty   Int
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  image          String?   // optional legacy image data
  category       String         @default("General")
  bookingItems   BookingItem[]
  returnedItems  ReturnedItem[]
  takenItems     TakenItem[]
}

model Booking {
  id           String        @id @default(uuid())
  userId       String
  eventDate    DateTime
  endDate      DateTime
  location     String
  status       BookingStatus @default(REQUEST)
  phoneNumber  String?   // optional – store payer mobile number
  totalPrice   Float
  deposit      Float
  balance      Float
  isLocked     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id])
  bookingItems  BookingItem[]
  payments      Payment[]
  returnedItems ReturnedItem[]
  takenItems    TakenItem[]
  refunds       Refund[]
}

model BookingItem {
  id           String     @id @default(uuid())
  bookingId    String
  decorationId String
  quantity     Int
  price        Float
  booking      Booking    @relation(fields: [bookingId], references: [id])
  decoration   Decoration @relation(fields: [decorationId], references: [id])
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String
  amount        Float
  method        PaymentMethod
  transactionId String        @unique
  status        PaymentStatus @default(PENDING)
  phoneNumber   String?   // optional – store payer mobile number
  referenceId            String?
  responseCode           String?
  responseMessage        String?
  rawPaymentResponse     Json?

  // Refund tracking fields
  refundTransactionId    String?
  refundReferenceId      String?
  refundReason           String?
  refundDate             DateTime?
  refundResponseCode     String?
  refundResponseMessage  String?
  rawWaafiResponse       Json?
  lastRefundAttempt      DateTime?
  refundCount            Int            @default(0)

  createdAt     DateTime      @default(now())
  booking       Booking       @relation(fields: [bookingId], references: [id])
  refunds       Refund[]
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  sentEmail Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  CUSTOMER
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REQUEST
  TAKEN
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  LOCAL_EVC
  LOCAL_EDAHAB
  LOCAL_SAHAL
  LOCAL_PREMIER_WALLET
  GLOBAL_MASTERCARD
  GLOBAL_PAYPAL
  MOBILE_MONEY
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum NotificationType {
  BOOKING
  PAYMENT
  REMINDER
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, code])
}

model ReturnedItem {
  id           String             @id @default(uuid())
  bookingId    String
  decorationId String
  userId       String             // The person who returned it
  quantity     Int
  status       ReturnedItemStatus @default(OK)
  remarks      String?
  returnedAt   DateTime           @default(now())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  booking      Booking    @relation(fields: [bookingId], references: [id])
  decoration   Decoration @relation(fields: [decorationId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
}

enum ReturnedItemStatus {
  OK
  DAMAGED
}

model CancellationRequest {
  id                String             @id @default(uuid())
  originalBookingId String             @unique
  userId            String
  userName          String
  bookingData       Json
  status            CancellationStatus @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id])
}

enum CancellationStatus {
  PENDING
  SUCCESS_CANCELED
  REFUND_FAILED
  REJECTED
}

model TakenItem {
  id           String    @id @default(uuid())
  bookingId    String
  decorationId String
  userId       String    // The staff/admin who recorded it
  quantity     Int
  remarks      String?
  takenAt      DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  booking      Booking    @relation(fields: [bookingId], references: [id])
  decoration   Decoration @relation(fields: [decorationId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
}

enum RefundStatus {
  SUCCESS
  FAILED
}

model Refund {
  id                    String        @id @default(uuid())
  paymentId             String @unique
  bookingId             String
  originalTransactionId String
  refundTransactionId   String?
  referenceId           String?
  amount                Float
  originalAmount        Float?
  reason                String
  status                RefundStatus
  responseCode          String
  responseMessage       String
  state                 String?
  requestedBy           String        // admin user ID
  requestedAt           DateTime      @default(now())
  completedAt           DateTime?
  customerName          String?
  customerPhone         String?
  rawRequest            Json?
  rawResponse           Json

  // Relations
  payment               Payment @relation(fields: [paymentId], references: [id])
  booking               Booking @relation(fields: [bookingId], references: [id])
}
